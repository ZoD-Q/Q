{
  "name": "xiaoq-mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "native",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:native": "node scripts/dev.mjs --native",
    "mobile": "npm run start --workspace=@xiaoq/native",
    "preview": "npm run web --workspace=@xiaoq/native",
    "typecheck": "npm run typecheck --workspace=@xiaoq/native",
    "lint": "npm run lint --workspace=@xiaoq/native",
    "test:utils": "npm run test:utils --workspace=@xiaoq/native",
    "export:web": "npm run export:web --workspace=@xiaoq/native",
    "api:generate": "openapi-typescript ../backend/contracts/openapi.json -o shared/src/generated.ts",
    "test:video": "npm run test:video --workspace=@xiaoq/native",
    "test:api-workbench": "npm run test:api-workbench --workspace=@xiaoq/native"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
