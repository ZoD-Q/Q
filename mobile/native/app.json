{
  "expo": {
    "name": "小Q",
    "slug": "xiaoq",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "xiaoq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "name": "小Q · Your everyday, connected"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
