{
  "expo": {
    "name": "小Q",
    "slug": "xiaoq",
    "version": "0.1.0",
    "icon": "./assets/brand/q-bubble-icon.png",
    "orientation": "default",
    "scheme": "xiaoq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kaicloud.xiaoq",
      "appleTeamId": "3996RYYTPW",
      "supportsTablet": true,
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaicloud.xiaoq",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "name": "小Q · Your everyday, connected"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
