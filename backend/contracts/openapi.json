{
  "openapi": "3.0.3",
  "info": {
    "title": "小Q Demo API",
    "version": "0.1.0",
    "description": "Local demonstration only. QDC uses integer minor units, 100 units = 1.00 Q. No real money."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "operationId": "register",
        "tags": [
          "identity"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "tags": [
          "identity"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": [
          "identity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getProfile",
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateProfile",
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        }
      }
    },
    "/v1/users/lookup": {
      "get": {
        "operationId": "lookupRecipient",
        "tags": [
          "profiles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipient"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/wallet": {
      "get": {
        "operationId": "getWallet",
        "tags": [
          "ledger"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet/transactions": {
      "get": {
        "operationId": "listTransactions",
        "tags": [
          "ledger"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionHistory"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet/transfers": {
      "post": {
        "operationId": "transfer",
        "tags": [
          "ledger"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque expiring session token; native clients keep it in SecureStore."
      }
    },
    "schemas": {
      "ThemeName": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "warm"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "zh-CN",
          "en"
        ]
      },
      "AvatarName": {
        "type": "string",
        "enum": [
          "orbit",
          "leaf",
          "spark",
          "wave"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          },
          "bio": {
            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeName"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "handle",
          "display_name",
          "avatar",
          "bio",
          "theme",
          "locale",
          "created_at"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          },
          "bio": {
            "type": "string",
            "maxLength": 160
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeName"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": []
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          }
        },
        "required": [
          "id",
          "handle",
          "display_name",
          "avatar"
        ]
      },
      "Wallet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "QDC"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          }
        },
        "required": [
          "account_id",
          "balance_minor",
          "currency",
          "mode"
        ]
      },
      "LedgerTransaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "welcome",
              "transfer"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100000000
          },
          "counterparty_handle": {
            "type": "string"
          },
          "counterparty_name": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "direction",
          "amount_minor",
          "counterparty_handle",
          "counterparty_name",
          "memo",
          "created_at"
        ]
      },
      "TransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipient_handle": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100000000
          },
          "memo": {
            "type": "string",
            "maxLength": 80
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "recipient_handle",
          "amount_minor",
          "memo",
          "idempotency_key"
        ]
      },
      "TransferResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transfer_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance_minor": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "transfer_id",
          "balance_minor",
          "created_at",
          "replayed"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "description": "Trimmed and lowercased; 3–24 ASCII letters/digits/underscore. xiaoq reserved."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "handle",
          "password",
          "display_name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "handle",
          "password"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          }
        },
        "required": [
          "status",
          "mode"
        ]
      },
      "TransactionHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerTransaction"
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  }
}
