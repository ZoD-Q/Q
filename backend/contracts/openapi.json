    "/v1/video/connections": {
      "get": {
        "operationId": "videoConnections",
        "tags": [
          "video"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoConnectionList"
                }
              }
            }
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "createVideoConnection",
        "tags": [
          "video"
        ],
        "description": "Save encrypted personal Kling credentials. Does not verify provider access or incur provider charges.",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoConnection"
                }
              }
            }
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoConnectionRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/video/connections/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "operationId": "revokeVideoConnection",
        "tags": [
          "video"
        ],
        "description": "Permanently revoke this connection. Prevent further provider requests; preserve job history.",
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/video/jobs": {
      "get": {
        "operationId": "videoJobs",
        "tags": [
          "video"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJobList"
                }
              }
            }
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "createVideoJob",
        "tags": [
          "video"
        ],
        "description": "Create a durable job before making one provider submission. Same key and payload replays without resubmitting. May incur supplier charges.",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJob"
                }
              }
            }
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay, no provider submission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJob"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoJobRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/video/jobs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "videoJob",
        "tags": [
          "video"
        ],
        "description": "Read and refresh an owned job. Unknown submissions only query the stable external task ID, never resubmit.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoJob"
                }
              }
            }
          },
          "default": {
            "description": "Structured error. See contracts/api.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque expiring session token; native clients keep it in SecureStore."
      }
    },
    "schemas": {
      "ThemeName": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "warm"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "zh-CN",
          "en"
        ]
      },
      "AvatarName": {
        "type": "string",
        "enum": [
          "orbit",
          "leaf",
          "spark",
          "wave"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          },
          "bio": {
            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeName"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "handle",
          "display_name",
          "avatar",
          "bio",
          "theme",
          "locale",
          "created_at"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          },
          "bio": {
            "type": "string",
            "maxLength": 160
          },
          "theme": {
            "$ref": "#/components/schemas/ThemeName"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": []
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "$ref": "#/components/schemas/AvatarName"
          }
        },
        "required": [
          "id",
          "handle",
          "display_name",
          "avatar"
        ]
      },
      "Wallet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "QDC"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          }
        },
        "required": [
          "account_id",
          "balance_minor",
          "currency",
          "mode"
        ]
      },
      "LedgerTransaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "welcome",
              "transfer"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100000000
          },
          "counterparty_handle": {
            "type": "string"
          },
          "counterparty_name": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "direction",
          "amount_minor",
          "counterparty_handle",
          "counterparty_name",
          "memo",
          "created_at"
        ]
      },
      "TransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipient_handle": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100000000
          },
          "memo": {
            "type": "string",
            "maxLength": 80
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "recipient_handle",
          "amount_minor",
          "memo",
          "idempotency_key"
        ]
      },
      "TransferResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transfer_id": {
            "type": "string",
            "format": "uuid"
          },
          "balance_minor": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "transfer_id",
          "balance_minor",
          "created_at",
          "replayed"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "description": "Trimmed and lowercased; 3–24 ASCII letters/digits/underscore. xiaoq reserved."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "handle",
          "password",
          "display_name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "handle",
          "password"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          }
        },
        "required": [
          "status",
          "mode"
        ]
      },
      "TransactionHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerTransaction"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "VideoConnection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "provider",
          "region",
          "created_at",
          "revoked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "provider": {
            "type": "string",
            "enum": [
              "kling"
            ]
          },
          "region": {
            "type": "string",
            "enum": [
              "cn",
              "global"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "VideoConnectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "region",
          "api_key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "region": {
            "type": "string",
            "enum": [
              "cn",
              "global"
            ]
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "writeOnly": true
          }
        }
      },
      "VideoJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "prompt",
          "model_name",
          "mode",
          "duration",
          "aspect_ratio",
          "idempotency_key"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
