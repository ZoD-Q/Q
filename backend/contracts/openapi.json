{
  "openapi": "3.0.3",
  "info": {
    "title": "小Q API",
    "version": "0.2.0",
    "description": "QDC ledger is simulated; explicitly configured personal Kling connections can make real supplier requests. Local development, not production certified."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; see contracts/api.md for status-specific codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
