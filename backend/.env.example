DATABASE_URL=postgresql://xiaoq:xiaoq_demo_local@127.0.0.1:55432/xiaoq_demo
Q_BIND=127.0.0.1:8787
Q_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Explicit opt-in: publicly documented local demo credentials.
Q_SEED_DEMO=false
RUST_LOG=xiaoq_backend=info

# Server-side only. Never use an EXPO_PUBLIC_ variable for this key.
# Leave unset to disable real DeepSeek requests.
DEEPSEEK_API_KEY=

# Optional MCP OAuth: persistent 32-byte base64 key and a public HTTPS origin.
# Anonymous MCP connections work with both unset. Never reuse the video key.
# Q_MCP_ENCRYPTION_KEY=
# Q_MCP_PUBLIC_BASE_URL=https://api.example.com
# Debug + plugin-test-fixtures only; rejects release builds and non-loopback origins.
# Q_MCP_LOCAL_FIXTURE_ORIGIN=http://127.0.0.1:8795

