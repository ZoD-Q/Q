[Unit]
Description=Q Beauty read-only MCP gallery
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=q-beauty
Group=q-beauty
WorkingDirectory=/opt/q-beauty/current
Environment=BEAUTY_MCP_BIND=127.0.0.1:18796
Environment=BEAUTY_MCP_PUBLIC_URL=https://q.kaicloudpay.com/plugins/beauty/
Environment=BEAUTY_MCP_DATA_DIR=/opt/q-beauty/current/data
Environment=TOKIO_WORKER_THREADS=2
ExecStart=/opt/q-beauty/current/bin/beauty_mcp
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:18796
InaccessiblePaths=-/etc/q -/opt/q -/var/lib/q -/var/backups/q
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
LogNamespace=q-beauty
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
