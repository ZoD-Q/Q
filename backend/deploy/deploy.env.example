# Copy to /etc/q/deploy.env with root:root ownership and mode 0600.
# Replace placeholders before starting. Do not commit real values.
Q_RELEASE=REVIEWED_COMMIT_SHA
# Inspect the dedicated existing Docker network before choosing fixed addresses.
# These values match the Q server inspected on 2026-10-20; verify before use.
Q_APPLICATION_NETWORK=q_application
Q_GATEWAY_APPLICATION_IP=172.29.0.3
# Directory must already exist, owned by root and readable by the gateway.
# For the inspected network, host.conf contains exactly: 172.29.0.1 1;
Q_TRUSTED_HOST_PROXIES_DIR=/etc/q/trusted-host-proxies
Q_DB_ADMIN_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
Q_DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
Q_VIDEO_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
Q_MCP_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_BASE64_ENCODED_32_RANDOM_BYTES
# Verified public HTTPS origin. Empty disables hosted OAuth.
Q_MCP_PUBLIC_BASE_URL=https://q.kaicloudpay.com
Q_CORS_ORIGINS=https://q.kaicloudpay.com,http://localhost:8081,http://127.0.0.1:8081
# Optional, server-only. Empty keeps real AI requests disabled.
DEEPSEEK_API_KEY=
