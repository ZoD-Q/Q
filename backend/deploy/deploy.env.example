# Copy to /etc/q/deploy.env with root:root ownership and mode 0600.
# Replace placeholders before starting. Do not commit real values.
Q_RELEASE=REVIEWED_COMMIT_SHA
Q_DB_ADMIN_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
Q_DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
Q_VIDEO_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
Q_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional, server-only. Empty keeps real AI requests disabled.
DEEPSEEK_API_KEY=
